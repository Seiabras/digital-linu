# Digital Linu (Seiabras/digital-linu, 6/11/2026): vídeo, redes sociais, anúncios, marca e automação
digital.linupedia.com.br {
	# os pedidos de orçamento (linu-pedidos no linuarquivos/servidor, 07/11/2026)
	handle /api/pedido {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:8094
	}
	# a identidade mora na Família Linu desde 07/11/2026
	redir /identidade https://familia.linupedia.com.br/identidade 301
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' https://farol.linupedia.com.br; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
	}
	@arquivos path /img/* /fontes/* /css/* /js/*
	header @arquivos Cache-Control "public, max-age=604800"
	root * /opt/digital-linu/app
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors {
		@nao_achei expression {err.status_code} == 404
		rewrite @nao_achei /404.html
		file_server
	}
}
